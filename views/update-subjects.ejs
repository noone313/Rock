<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>تحديث بيانات المادة</title>
  <style>
    :root {
      --primary-color: #007bff;
      --primary-hover: #0056b3;
      --background-color: #f8f9fa;
      --text-color: #333;
      --form-background: #ffffff;
      --table-border: #ccc;
    }
    body {
      font-family: Arial, sans-serif;
      background-color: var(--background-color);
      color: var(--text-color);
      margin: 0;
      padding: 20px;
    }
    .container {
      max-width: 800px;
      margin: auto;
      background-color: var(--form-background);
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }
    h1 {
      text-align: center;
      color: var(--primary-color);
    }
    label {
      display: block;
      margin-bottom: 10px;
    }
    input[type="text"], input[type="number"], select {
      width: 100%;
      padding: 10px;
      margin-bottom: 20px;
      border: 1px solid var(--table-border);
      border-radius: 5px;
    }
    button {
      background-color: var(--primary-color);
      color: white;
      padding: 10px 20px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }
    button:hover {
      background-color: var(--primary-hover);
    }
  </style>
</head>
<body>

  <div class="container">
    <h1>تحديث بيانات المادة</h1>

    <form id="updateForm">
      <label for="subname">اسم المادة</label>
      <input type="text" id="subname" value="<%= subject.subname %>" required />

      <label for="substage">عدد المراحل</label>
      <input type="number" id="substage" value="<%= subject.substage %>" required />


      <label for="deptid">القسم</label>
      <input type="number" id="deptid" value="<%= subject.deptid %>" required />

      <button type="submit">تحديث</button>
    </form>

    <p id="message" style="text-align: center; color: green;"></p>
  </div>

  <script>
    document.getElementById('updateForm').addEventListener('submit', async function (event) {
      event.preventDefault(); // منع الإرسال التقليدي للنموذج

      // الحصول على البيانات من الحقول
      const subname = document.getElementById('subname').value;
      const substage = document.getElementById('substage').value;
     
      const deptid = document.getElementById('deptid').value;

      // إرسال الطلب باستخدام Fetch API
      const subid = "<%= subject.subid %>"; // subid موجود في EJS ويجب أن يتم تمريره من الخادم

      try {
        const response = await fetch(`/subjects/${subid}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            subname,
            substage,
            deptid,
          }),
        });

        // التعامل مع الاستجابة
        if (response.ok) {
          const result = await response.json();
          document.getElementById('message').textContent = 'تم تحديث المادة بنجاح!';
        } else {
          document.getElementById('message').textContent = 'حدث خطأ أثناء تحديث المادة.';
        }
      } catch (error) {
        console.error('Error:', error);
        document.getElementById('message').textContent = 'حدث خطأ أثناء تحديث المادة.';
      }
    });
  </script>

</body>
</html>
