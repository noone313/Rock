<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>تحديث بيانات القسم</title>
  <style>
   :root {
      --primary-color: #007bff;
      --primary-hover: #0056b3;
      --background-color: #f8f9fa;
      --text-color: #333;
      --form-background: #ffffff;
      --table-border: #ccc;
    }
    body {
      font-family: Arial, sans-serif;
      background-color: var(--background-color);
      color: var(--text-color);
      margin: 0;
      padding: 20px;
    }
    .container {
      max-width: 800px;
      margin: auto;
      background-color: var(--form-background);
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }
    h1 {
      text-align: center;
      color: var(--primary-color);
    }
    label {
      display: block;
      margin-bottom: 10px;
    }
    input[type="text"], input[type="number"] {
      width: 100%;
      padding: 10px;
      margin-bottom: 20px;
      border: 1px solid var(--table-border);
      border-radius: 5px;
    }
    button {
      background-color: var(--primary-color);
      color: white;
      padding: 10px 20px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }
    button:hover {
      background-color: var(--primary-hover);
    }
  </style>
</head>
<body>

  <div class="container">
    <h1>تحديث بيانات القسم</h1>

    <form id="updateForm">
      <label for="deptname">اسم القسم</label>
      <input type="text" id="deptname" value="<%= department.deptname %>" required />

      <label for="deptstages">عدد المراحل</label>
      <input type="number" id="deptstages" value="<%= department.deptstages %>" required />

      <button type="submit">تحديث</button>
    </form>

    <p id="message" style="text-align: center; color: green;"></p>
  </div>

  <script>
    document.getElementById('updateForm').addEventListener('submit', async function (event) {
      event.preventDefault(); // منع الإرسال التقليدي للنموذج

      // الحصول على البيانات من الحقول
      const deptname = document.getElementById('deptname').value;
      const deptstages = document.getElementById('deptstages').value;

      // إرسال الطلب باستخدام Fetch API
      const deptid = "<%= department.deptid %>"; // deptid موجود في EJS ويجب أن يتم تمريره من الخادم

      try {
        const response = await fetch(`/departments/${deptid}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            deptname,
            deptstages,
          }),
        });

        // التعامل مع الاستجابة
        if (response.ok) {
          const result = await response.json();
          document.getElementById('message').textContent = 'تم تحديث القسم بنجاح!';
        } else {
          document.getElementById('message').textContent = 'حدث خطأ أثناء تحديث القسم.';
        }
      } catch (error) {
        console.error('Error:', error);
        document.getElementById('message').textContent = 'حدث خطأ أثناء تحديث القسم.';
      }
    });
  </script>

</body>
</html>
