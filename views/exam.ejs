<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= exam.examname %> - Exam</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <style>
    .form-group {
      margin-bottom: 15px;
    }
    .drag-container {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .draggable {
      padding: 10px;
      background-color: #f1f1f1;
      border: 1px solid #ddd;
      cursor: pointer;
      border-radius: 5px;
    }
    .dropzone {
      width: 100%;
      min-height: 50px;
      background-color: #eaeaea;
      border: 2px dashed #ccc;
      text-align: center;
      line-height: 50px;
      margin-top: 20px;
      position: relative;
    }
    .dragover {
      background-color: #d3d3d3;
    }
  </style>
</head>
<body>
  <div class="container mt-4">
    <h1 class="text-center"><%= exam.examname %></h1>
    <p class="text-center">Time: <%= exam.examtime %> minutes</p>
    <form id="exam-form" action="/answers" method="POST">
      <input type="hidden" name="examid" value="<%= exam.examid %>">
      <input type="hidden" name="userid" value="<%= userid %>">

      <% questions.forEach((question, index) => { %>
        <div class="mb-4">
          <h5>Q<%= index + 1 %>: <%= question.qtext %></h5>

          <!-- Regular Choice -->
          <% if (question.qtype === 'regular choice') { %>
            <% question.options.forEach(option => { %>
              <div class="form-check">
                <input 
                  class="form-check-input" 
                  type="radio" 
                  name="selected_option[<%= question.qid %>]" 
                  value="<%= option.opid %>" 
                  id="option-<%= option.opid %>">
                <label class="form-check-label" for="option-<%= option.opid %>">
                  <%= option.optext %>
                </label>
              </div>
            <% }); %>

          <!-- Multiple Choice -->
          <% } else if (question.qtype === 'multiple choice') { %>
            <% question.options.forEach(option => { %>
              <div class="form-check">
                <input 
                  class="form-check-input" 
                  type="checkbox" 
                  name="selected_option[<%= question.qid %>][]" 
                  value="<%= option.opid %>"
                  id="option-<%= option.opid %>">
                <label class="form-check-label" for="option-<%= option.opid %>">
                  <%= option.optext %>
                </label>
              </div>
            <% }); %>

          <!-- True/False -->
          <% } else if (question.qtype === 'true/false') { %>
            <div class="form-group">
              <select 
                class="form-select" 
                name="selected_option[<%= question.qid %>]" 
                required>
                <option value="" disabled selected>Select an answer</option>
                <% question.options.forEach(option => { %>
                  <option value="<%= option.opid %>"><%= option.optext %></option>
                <% }); %>
              </select>
            </div>

          <!-- Fill in the Blank (Replaced with Drag and Drop) -->
          <% } else if (question.qtype === 'fill in the blank') { %>
            <div class="form-group">
              <label for="question-<%= question.qid %>">Select the correct answer for the blank:</label>
              <div class="drag-container">
                <% question.options.forEach(option => { %>
                  <div 
                    class="draggable" 
                    draggable="true" 
                    data-opid="<%= option.opid %>">
                    <%= option.optext %>
                  </div>
                <% }); %>
              </div>
              <div class="dropzone" data-qid="<%= question.qid %>">
                <span class="placeholder">Drop here</span>
              </div>
              <input type="hidden" name="selected_option[<%= question.qid %>]" value="">
            </div>

          <!-- Short Answer -->
          <% } else if (question.qtype === 'short answer') { %>
            <textarea 
              class="form-control" 
              name="text_answer[<%= question.qid %>]" 
              rows="2" 
              placeholder="Your answer here"></textarea>
          <% } %>
        </div>
      <% }); %>

      <button type="submit" class="btn btn-primary">Submit Answers</button>
    </form>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const draggables = document.querySelectorAll('.draggable');
      const dropzones = document.querySelectorAll('.dropzone');
      
      // Handle Drag and Drop events
      draggables.forEach(draggable => {
        draggable.addEventListener('dragstart', () => {
          draggable.classList.add('dragging');
        });
  
        draggable.addEventListener('dragend', () => {
          draggable.classList.remove('dragging');
        });
      });
  
      dropzones.forEach(dropzone => {
        dropzone.addEventListener('dragover', (e) => {
          e.preventDefault();
          dropzone.classList.add('dragover');
        });
  
        dropzone.addEventListener('dragleave', () => {
          dropzone.classList.remove('dragover');
        });
  
        dropzone.addEventListener('drop', (e) => {
          e.preventDefault();
          dropzone.classList.remove('dragover');
          
          const draggable = document.querySelector('.dragging');
          if (draggable) {
            dropzone.innerHTML = '';
            dropzone.appendChild(draggable.cloneNode(true));
            const qid = dropzone.getAttribute('data-qid');
            const opid = draggable.getAttribute('data-opid');
            const input = document.querySelector(`input[name="selected_option[${qid}]"]`);
            if (input) {
              input.value = opid; // Store the answer in the hidden input field
            }
          }
        });
      });
  
      // Handle form submission
      document.querySelector('#exam-form').addEventListener('submit', (e) => {
        e.preventDefault();
  
        const formData = {
          examid: document.querySelector('[name="examid"]').value,
          userid: document.querySelector('[name="userid"]').value,
          selected_option: {},
          text_answer: {}
        };
  
        // Gather selected options
        const selectedOptions = document.querySelectorAll('input[name^="selected_option"]');
        selectedOptions.forEach(input => {
          const qid = input.name.split('[')[1].split(']')[0];
          const opid = input.value;
  
          // Handle multiple choice (checkbox)
          if (input.type === 'checkbox') {
            if (!formData.selected_option[qid]) {
              formData.selected_option[qid] = [];
            }
            if (input.checked) {
              formData.selected_option[qid].push(opid);
            }
          } else {
            // Handle regular choice (radio button)
            if (opid) {
              formData.selected_option[qid] = opid;
            }
          }
        });
  
        // Gather text answers
        const textAreas = document.querySelectorAll('textarea[name^="text_answer"]');
        textAreas.forEach(textArea => {
          const qid = textArea.name.split('[')[1].split(']')[0];
          formData.text_answer[qid] = textArea.value;
        });
  
        // Handle drag-and-drop answers (fill in the blank)
        const dropzones = document.querySelectorAll('.dropzone');
        dropzones.forEach(dropzone => {
          const qid = dropzone.getAttribute('data-qid');
          const opid = dropzone.querySelector('.draggable') ? dropzone.querySelector('.draggable').getAttribute('data-opid') : null;
          if (opid) {
            formData.selected_option[qid] = opid;
          }
        });
  
        // Gather True/False answers (select dropdown)
        const trueFalseSelects = document.querySelectorAll('select[name^="selected_option"]');
        trueFalseSelects.forEach(select => {
          const qid = select.name.split('[')[1].split(']')[0];
          const selectedValue = select.value;
          if (selectedValue) {
            formData.selected_option[qid] = selectedValue;
          }
        });
  
        // Send form data as JSON
        fetch('/answers', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(formData),
        })
        .then(response => response.json())
        .then(data => {
          console.log('Form submitted successfully:', data);
        })
        .catch(error => {
          console.error('Error submitting form:', error);
        });
      });
    });
  </script>
  
</body>
</html>
