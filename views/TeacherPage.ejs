<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إنشاء اختبار</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary: #3B82F6;
            --primary-hover: #2563EB;
            --secondary: #2563EB;
            --surface: #FFFFFF;
            --background: #F8FAFC;
            --light: #FFFFFF;
            --text-primary: #1E293B;
            --text-secondary: #64748B;
            --border: #E2E8F0;
            --shadow-sm: 0 1px 3px rgba(0,0,0,0.12);
            --radius-md: 8px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Tajawal', sans-serif;
        }

        body {
            background: var(--background);
            color: var(--text-primary);
        }

        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 2rem;
            background: var(--surface);
            box-shadow: var(--shadow-sm);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .nav_logo a {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary);
            text-decoration: none;
        }

        .nav_links {
            display: flex;
            gap: 2rem;
            list-style: none;
        }

        .nav_links a {
            text-decoration: none;
            color: var(--text-primary);
            font-weight: 500;
            transition: color 0.3s;
        }

        .nav_links a:hover {
            color: var(--primary);
        }

        .nav_btns {
            position: relative;
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .btn {
            background: var(--primary);
            color: white;
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: var(--radius-md);
            cursor: pointer;
            transition: background 0.3s;
        }

        .btn:hover {
            background: var(--primary-hover);
        }

        .card {
            position: absolute;
            left: 0;
            top: 120%;
            background: var(--surface);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            padding: 1.5rem;
            min-width: 250px;
            display: none;
        }

        .card.show {
            display: block;
        }

        .user-info {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            align-items: center;
        }

        .user-info i {
            font-size: 1.5rem;
            color: var(--text-secondary);
        }

        .user-info h4 {
            font-size: 1.25rem;
            color: var(--text-primary);
        }

        .user-info p {
            font-size: 0.875rem;
            color: var(--text-secondary);
        }

        .logout-btn {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-primary);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s;
        }

        .logout-btn:hover {
            color: var(--primary);
        }

        .container {
            max-width: 1000px;
            margin: 2rem auto;
            background: var(--surface);
            border-radius: 24px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            padding: 3rem;
        }

        h1 {
            color: var(--primary);
            text-align: center;
            margin-bottom: 2.5rem;
            font-size: 2.5rem;
            position: relative;
        }

        h1:after {
            content: '';
            display: block;
            width: 60px;
            height: 3px;
            background: var(--secondary);
            margin: 1rem auto;
        }

        .form-section {
            background: rgba(244, 245, 247, 0.5);
            padding: 2rem;
            border-radius: 16px;
            margin-bottom: 2rem;
        }

        label {
            display: block;
            margin: 1.2rem 0 0.5rem;
            font-weight: 600;
            color: var(--text-primary);
        }

        input, select {
            width: 100%;
            padding: 0.8rem 1.2rem;
            border: 2px solid var(--border);
            border-radius: var(--radius-md);
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        button {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white !important;
            border: none;
            padding: 0.8rem 1.6rem;
            border-radius: var(--radius-md);
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            font-weight: 600;
            margin-top: 1.5rem;
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
        }

        .delete-option-btn {
            background: var(--primary);
            color: var(--surface);
            border: none;
            border-radius: var(--radius-md);
            padding: 0.5rem 1rem;
            cursor: pointer;
            transition: transform 0.3s;
            font-size: 0.9rem;
            margin-right: 1rem;
        }

        #questionsSection {
            margin-top: 2rem;
        }

        .question-section {
            background: var(--surface);
            padding: 2rem;
            border-radius: 12px;
            margin-bottom: 2rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            border: 1px solid #f1f5f9;
        }

        .options {
            margin-top: 1.5rem;
            padding: 1.5rem;
            background: var(--light);
            border-radius: var(--radius-md);
        }

        .option {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin: 1rem 0;
            padding: 1rem;
            background: var(--surface);
            border-radius: var(--radius-md);
            border: 1px solid #f1f5f9;
        }

        .matching-pair {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            width: 100%;
            padding: 1rem;
            background: var(--surface);
            border-radius: var(--radius-md);
            border: 1px solid var(--border);
            margin: 0.5rem 0;
        }

        .matching-inputs {
            display: flex;
            gap: 1rem;
            width: 100%;
        }

        .matching-inputs > div {
            flex: 1;
        }

        @media (max-width: 768px) {
            nav {
                padding: 1rem;
                flex-wrap: wrap;
                gap: 1rem;
            }
            .nav_links {
                order: 3;
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <nav>
        <div class="nav_header">
            <div class="nav_logo">
                <a href="/">Rock</a>
            </div>
        </div>
        
        <ul class="nav_links">
            <li><a href="/active-exams">الاختبارات النشطة</a></li>
            <li><a href="/results">النتائج</a></li>
            <li><a href="/users/<%= userid %>">الملف الشخصي</a></li>

        </ul>

        <div class="nav_btns">
            <button class="btn" id="profile-btn">
                <i class="fa-solid fa-user"></i>
            </button>
            <div class="card" id="profile-card">
                <div class="user-info">
                    <i class="fa-regular fa-user"></i>
                    <h4><%= user_name %></h4>
                    <p><%= email %></p>
                </div>
                <hr>
                <a href="/logout" class="logout-btn" id="logout-btn">
                    <i class="fas fa-sign-out-alt"></i> تسجيل الخروج
                </a>
            </div>
        </div>
    </nav>
    <div class="container">
        <form id="examForm" action="/exams" method="POST">
            <h1><i class="fas fa-edit"></i> إنشاء اختبار جديد</h1>

            <div class="form-section">
                <label for="examname">اسم الاختبار:</label>
                <input type="text" id="examname" name="exam[examname]" required>

                <label for="examtime">مدة الاختبار (دقائق):</label>
                <input type="number" id="examtime" name="exam[examtime]" required>

                <label for="question_count">عدد الأسئلة:</label>
                <input type="number" id="question_count" name="exam[question_count]" required min="1">

                <button type="button" id="nextButton">
                    <i class="fas fa-arrow-left"></i>
                    المتابعة
                </button>
            </div>

            <div id="questionsSection"></div>
            
            <button type="submit" id="submitButton" style="display: none;">
                <i class="fas fa-save"></i>
                إنشاء الاختبار
            </button>
        </form>
    </div>

    <script>
        // تبديل بطاقة الملف الشخصي
        const profileBtn = document.getElementById('profile-btn');
        const profileCard = document.getElementById('profile-card');

        profileBtn.addEventListener('click', () => {
            profileCard.classList.toggle('show');
        });

        // إغلاق البطاقة عند النقر خارجها
        document.addEventListener('click', (e) => {
            if (!profileBtn.contains(e.target) && !profileCard.contains(e.target)) {
                profileCard.classList.remove('show');
            }
        });

        document.getElementById('nextButton').addEventListener('click', function() {
            const questionCount = document.getElementById('question_count').value;
            const questionsSection = document.getElementById('questionsSection');

            document.getElementById('nextButton').style.display = 'none';
            document.getElementById('submitButton').style.display = 'flex';

            questionsSection.innerHTML = '';

            for (let i = 0; i < questionCount; i++) {
                const questionDiv = document.createElement('div');
                questionDiv.classList.add('question-section');
                questionDiv.innerHTML = ` 
                    <h3>السؤال ${i + 1}</h3>
                    <label for="questions[${i}][qtext]">نص السؤال:</label>
                    <input type="text" id="questions[${i}][qtext]" name="questions[${i}][qtext]" required>

                    <label for="questions[${i}][qtype]">نوع السؤال:</label>
                    <select id="questions[${i}][qtype]" name="questions[${i}][qtype]" required>
                        <option value="multiple choice">اختيار متعدد</option>
                        <option value="true/false">صحيح/خطأ</option>
                        <option value="fill in the blank">ملء الفراغ</option>
                        <option value="regular choice">اختيار فردي</option>
                        <option value="short answer">إجابة قصيرة</option>
                        <option value="matching">توصيل الأعمدة</option>
                    </select>

                    <div class="options" id="options_${i}">
                        <h4>الخيارات</h4>
                        <button type="button" onclick="addOption(${i})">
                            <i class="fas fa-plus"></i>
                            إضافة خيار
                        </button>
                    </div>
                `;
                questionsSection.appendChild(questionDiv);
                
                // إضافة حدث تغيير لنوع السؤال
                const typeSelect = questionDiv.querySelector('select');
                typeSelect.addEventListener('change', function() {
                    handleQuestionTypeChange(i);
                });
            }
        });

        function handleQuestionTypeChange(questionIndex) {
            const optionsDiv = document.getElementById(`options_${questionIndex}`);
            const questionType = document.getElementById(`questions[${questionIndex}][qtype]`).value;
            
            optionsDiv.innerHTML = `<h4>${questionType === 'matching' ? 'أزواج التوصيل' : 'الخيارات'}</h4>`;
            
            const addButton = document.createElement('button');
            addButton.type = 'button';
            addButton.onclick = () => addOption(questionIndex);
            addButton.innerHTML = `<i class="fas fa-plus"></i> ${questionType === 'matching' ? 'إضافة زوج' : 'إضافة خيار'}`;
            optionsDiv.appendChild(addButton);
        }

        function addOption(questionIndex) {
            const questionType = document.getElementById(`questions[${questionIndex}][qtype]`).value;
            const optionsDiv = document.getElementById(`options_${questionIndex}`);
            
            if (questionType === 'matching') {
                const pairCount = optionsDiv.querySelectorAll('.matching-pair').length;
                
                const pairDiv = document.createElement('div');
                pairDiv.classList.add('matching-pair');
                pairDiv.innerHTML = `
                    <div class="matching-inputs">
                        <div>
                            <label>العنصر الأيسر:</label>
                            <input type="text" 
                                   name="questions[${questionIndex}][pairs][${pairCount}][left]" 
                                   required>
                        </div>
                        <div>
                            <label>العنصر الأيمن:</label>
                            <input type="text" 
                                   name="questions[${questionIndex}][pairs][${pairCount}][right]" 
                                   required>
                        </div>
                    </div>
                    <button type="button" class="delete-option-btn" onclick="deleteOption(this)">
                        <i class="fas fa-trash"></i> حذف
                    </button>
                `;
                optionsDiv.insertBefore(pairDiv, optionsDiv.lastElementChild);
            } else {
                const optionCount = optionsDiv.querySelectorAll('.option:not(.matching-pair)').length;
                
                const optionDiv = document.createElement('div');
                optionDiv.classList.add('option');
                optionDiv.innerHTML = ` 
                    <label>الخيار ${optionCount + 1}:</label>
                    <input type="text" 
                           name="questions[${questionIndex}][options][${optionCount}][optext]" 
                           required>

                    <label class="checkbox-label">
                        <input type="${questionType === 'regular choice' ? 'radio' : 'checkbox'}" 
                               class="iscorrect-checkbox" 
                               name="questions[${questionIndex}][correct]" 
                               value="${optionCount}">
                        الإجابة الصحيحة
                    </label>
                    
                    <button type="button" class="delete-option-btn" onclick="deleteOption(this)">
                        <i class="fas fa-trash"></i> حذف
                    </button>
                `;
                optionsDiv.insertBefore(optionDiv, optionsDiv.lastElementChild);
            }
        }

        function deleteOption(button) {
            button.parentElement.remove();
        }
    </script>
</body>
</html>