<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>نتائج الامتحانات</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <style>
  :root {
    --primary: #3B82F6;
    --primary-hover: #2563EB;
    --surface: #FFFFFF;
    --background: #F8FAFC;
    --text-primary: #1E293B;
    --text-secondary: #64748B;
    --border: #E2E8F0;
    --shadow-sm: 0 1px 3px rgba(0,0,0,0.12);
    --radius-md: 8px;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Inter', sans-serif;
}

body {
    background: var(--background);
    color: var(--text-primary);
}
    
    
    .container {
      width: 90%;
      margin: 2rem auto;
      background: white;
      padding: 2rem;
      border-radius: 1.5rem;
      box-shadow: 0 8px 30px rgba(0,0,0,0.12);
    }
    
    h1 {
      color: #2563eb;
      margin-bottom: 2rem;
      font-size: 2.2rem;
    }
    
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 1.5rem;
    }
    
    th, td {
      padding: 1rem;
      text-align: center;
      border-bottom: 2px solid #e5e7eb;
    }
    
    th {
      background: #2563eb;
      color: white;
      font-weight: 600;
      letter-spacing: 0.5px;
    }
    
    tr:hover {
      background-color: #f3f4f6;
    }
    
    .export-btn {
      background: linear-gradient(135deg, #3b82f6, #2563eb);
      color: white !important;
      border: none;
      padding: 0.6rem 1.2rem;
      border-radius: 0.75rem;
      cursor: pointer;
      transition: all 0.3s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 500;
      box-shadow: 0 4px 6px rgba(59,130,246,0.2);
    }
    
    .export-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 12px rgba(59,130,246,0.3);
    }
    
    .export-btn i {
      font-size: 1.1rem;
    }
    
    .passed {
      color: #22c55e;
      font-weight: 600;
    }
    
    .failed {
      color: #ef4444;
      font-weight: 600;
    }
    
    /* أنماط نموذج الشهادة المخفي */
    .certificate-template {
      position: absolute;
      left: -9999px; /* لإخفاء النموذج عن العرض */
      width: 1200px;
      height: 800px;
      background: #fff;
      padding: 2rem;
      text-align: center;
      border: 10px solid #3B82F6;
      box-shadow: 0 0 15px rgba(0,0,0,0.3);
    }
    
    .certificate-content {
      position: relative;
      width: 100%;
      height: 100%;
      padding: 2rem;
    }
    
    .certificate-title {
      font-size: 3.5rem;
      color: #1D4ED8;
      margin-bottom: 1rem;
      font-family: 'Arial', sans-serif;
      text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
    }
    
    .certificate-text {
      font-size: 1.8rem;
      color: #1E293B;
      line-height: 1.6;
      margin: 2rem 0;
    }
    
    .certificate-details {
      font-size: 1.5rem;
      color: #64748B;
      margin: 1.5rem 0;
    }
    
    .certificate-logo {
      width: 150px;
      margin-bottom: 1rem;
    }
    
    .certificate-signature {
      position: absolute;
      bottom: 2rem;
      right: 2rem;
      text-align: center;
      font-size: 1.2rem;
      border-top: 2px solid #1D4ED8;
      padding-top: 0.5rem;
      width: 250px;
      margin: 0 auto;
    }
  



/* Navigation Styles */
nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    position: sticky;
    top: 0;
    z-index: 100;
}

.nav_logo a {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary);
    text-decoration: none;
}

.nav_links {
    display: flex;
    gap: 2rem;
    list-style: none;
}

.nav_links a {
    text-decoration: none;
    color: var(--text-primary);
    font-weight: 500;
    transition: color 0.3s;
}

.nav_links a:hover {
    color: var(--primary);
}

.nav_btns {
    position: relative;
    display: flex;
    gap: 1rem;
    align-items: center;
}

.btn {
    background: var(--primary);
    color: white;
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: background 0.3s;
}

.btn:hover {
    background: var(--primary-hover);
}

.card {
    position: absolute;
    right: 0;
    top: 120%;
    background: var(--surface);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    padding: 1.5rem;
    min-width: 250px;
    display: none;
}

.card.show {
    display: block;
}

.user-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
}

.user-info i {
    font-size: 1.5rem;
    color: var(--text-secondary);
}

.user-info h4 {
    font-size: 1.25rem;
    color: var(--text-primary);
}

.user-info p {
    font-size: 0.875rem;
    color: var(--text-secondary);
}

.logout-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s;
}

.logout-btn:hover {
    color: var(--primary);
}

/* Responsive Design */
@media (max-width: 768px) {
    nav {
        padding: 1rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .nav_links {
        order: 3;
        width: 100%;
        justify-content: center;
    }
}
  </style>
</head>
<body>

  <nav>
    <div class="nav_header">
        <div class="nav_logo">
            <a href="/">Rock</a>
        </div>
    </div>
    
    <ul class="nav_links">
        <li><a href="/active-exams">Active Exams</a></li>
        <li><a href="/results">Results</a></li>
    </ul>

    <div class="nav_btns">
        <button class="btn" id="profile-btn">
            <i class="fa-solid fa-user"></i>
        </button>
        <div class="card" id="profile-card">
            <div class="user-info">
                <i class="fa-regular fa-user"></i>
                <h4><%= user_name %></h4>
                <p><%= email %></p>
            </div>
            <hr>
            <a href="/logout" class="logout-btn" id="logout-btn">
                <i class="fas fa-sign-out-alt"></i> تسجيل الخروج
            </a>
        </div>
    </div>
</nav>
  <div class="container">
    <h1>نتائج الامتحانات 📊</h1>
    <table>
      <thead>
        <tr>
          <th>اسم الطالب</th>
          <th>البريد الإلكتروني</th>
          <th>الامتحان</th>
          <th>النتيجة</th>
          <th>الحالة</th>
          <th>التاريخ والوقت</th>
          <th>تصدير</th>
        </tr>
      </thead>
      <tbody>
        <% results.forEach(result => { %>
          <tr id="result-<%= result.resultid %>">
            <td class="student-name"><%= result.User.user_name %></td>
            <td class="student-email"><%= result.User.email %></td>
            <td class="exam-name"><%= result.Exam.examname %></td>
            <td class="score"><%= result.total_score %></td>
            <td class="status <%= result.passed ? 'passed' : 'failed' %>">
              <%= result.passed ? 'ناجح 🎉' : 'راسب ⚠️' %>
            </td>
            <td class="date"><%= new Date(result.createdAt).toLocaleString('ar-EG') %></td>
            <td>
              <button class="export-btn" onclick="exportCertificate('<%= result.resultid %>')">
                <i class="fas fa-download"></i>
                تصدير الشهادة
              </button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  
  <!-- نموذج الشهادة المخفي -->
  <div class="certificate-template" id="certificateTemplate">
    <div class="certificate-content">
      <img src="university-logo.png" alt="شعار الجامعة" class="certificate-logo">
      <h1 class="certificate-title">شهادة نجاح</h1>
      <p class="certificate-text">
        تُمنح هذه الشهادة لـ
        <br>
        <strong id="certStudentName">[اسم الطالب]</strong>
        <br><br>
        لإثبات اجتيازه بنجاح امتحان مادة
        <br>
        <strong id="certExamName">[اسم الامتحان]</strong>
      </p>
      <div class="certificate-details">
        <p>النتيجة: <span id="certScore">[النتيجة]</span></p>
        <p>الحالة: <span id="certStatus">[الحالة]</span></p>
        <p>تاريخ الإجراء: <span id="certDate">[التاريخ]</span></p>
      </div>
        
  </div>
  
  <!-- استدعاء مكتبة html2canvas -->
  <script src="https://html2canvas.hertzen.com/dist/html2canvas.min.js"></script>
  <script>

    // Toggle profile card
const profileBtn = document.getElementById('profile-btn');
const profileCard = document.getElementById('profile-card');

profileBtn.addEventListener('click', () => {
    profileCard.classList.toggle('show');
});

// Close card when clicking outside
document.addEventListener('click', (e) => {
    if (!profileBtn.contains(e.target) && !profileCard.contains(e.target)) {
        profileCard.classList.remove('show');
    }
});

    async function exportCertificate(resultId) {
      try {
        // الحصول على بيانات الصف من الجدول
        const row = document.getElementById('result-' + resultId);
        const studentName = row.querySelector('.student-name').textContent.trim();
        const examName = row.querySelector('.exam-name').textContent.trim();
        const score = row.querySelector('.score').textContent.trim();
        const status = row.querySelector('.status').textContent.trim();
        const date = row.querySelector('.date').textContent.trim();
  
        // تعبئة بيانات نموذج الشهادة
        document.getElementById('certStudentName').textContent = studentName;
        document.getElementById('certExamName').textContent = examName;
        document.getElementById('certScore').textContent = score;
        document.getElementById('certStatus').textContent = status;
        document.getElementById('certDate').textContent = date;
  
        // إظهار نموذج الشهادة المخفي مؤقتًا إذا لزم الأمر (لا حاجة إذا كان خارج الشاشة)
        const certificateElement = document.getElementById('certificateTemplate');
  
        // استخدام html2canvas لالتقاط النموذج
        const canvas = await html2canvas(certificateElement, {
          useCORS: true,
          scale: 2,
          logging: true
        });
  
        // تحويل الصورة إلى رابط للتحميل
        const link = document.createElement('a');
        link.download = `شهادة-${studentName}.png`;
        link.href = canvas.toDataURL('image/png');
        link.click();
  
      } catch (error) {
        console.error('حدث خطأ أثناء تصدير الشهادة:', error);
        alert('حدث خطأ أثناء تصدير الشهادة. يرجى المحاولة مرة أخرى.');
      }
    }
  </script>
</body>
</html>
