<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>قائمة الأسئلة</title>
  <style>
    :root {
      --primary-color: #007bff;
      --primary-hover: #0056b3;
      --background-color: #f8f9fa;
      --text-color: #333;
      --form-background: #ffffff;
      --table-border: #ccc;
    }
    body {
      font-family: Arial, sans-serif;
      background-color: var(--background-color);
      color: var(--text-color);
      margin: 0;
      padding: 20px;
    }
    .container {
      max-width: 900px;
      margin: auto;
      background-color: var(--form-background);
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }
    h1 {
      text-align: center;
      color: var(--primary-color);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }
    th, td {
      border: 1px solid var(--table-border);
      padding: 10px;
      text-align: center;
    }
    th {
      background-color: var(--primary-color);
      color: white;
    }
    tr:nth-child(even) {
      background-color: #f2f2f2;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>قائمة الأسئلة</h1>

    <% if (message) { %>
      <p style="text-align: center; color: red;"><%= message %></p>
    <% } else { %>

    <table>
      <thead>
        <tr>
          <th>رقم الامتحان</th>
          <th>رقم السؤال</th>
          <th>نص السؤال</th>
          <th>الخيارات</th>
        </tr>
      </thead>
      <tbody>
        <% questions.forEach(question => { %>
          <tr>
            <td><%= question.examid %></td>
            <td><%= question.qid %></td>
            <td><a href="/questions/<%= question.qid %>"><%= question.qtext %></a></td>
            <td>
              <ul>
                <% question.Options.forEach(option => { %>
                  <li><%= option.optext %> <% if (option.isCorrect) { %> ✅ <% } %></li>
                <% }); %>
              </ul>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <% } %>
  </div>
</body>
</html>
